# BookNook Server Environment Variables

# Express API Port
PORT=5000

# Allowed Frontend Origins (comma-separated for multiple origins)
CLIENT_URL=http://localhost:3000,https://booknook-client-roan.vercel.app

# Shared JWT secret key (must match JWT_SECRET in booknook-client)
JWT_SECRET=your_jwt_secret_key_here

# MongoDB Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=booknook
